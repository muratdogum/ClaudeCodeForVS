<UserControl x:Class="ClaudeCodeVS.ToolWindows.ClaudeChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CcAccent" Color="#D97757" />
        <SolidColorBrush x:Key="CcAccentHover" Color="#E38B6E" />
        <SolidColorBrush x:Key="CcAccentPressed" Color="#C2603F" />
        <SolidColorBrush x:Key="CcAccentSoft" Color="#26D97757" />
        <SolidColorBrush x:Key="CcHover" Color="#1F808080" />
        <SolidColorBrush x:Key="CcPressed" Color="#33808080" />
        <SolidColorBrush x:Key="CcError" Color="#E05252" />
        <SolidColorBrush x:Key="CcErrorSoft" Color="#1FE05252" />
        <SolidColorBrush x:Key="CcErrorBorder" Color="#59E05252" />
        <FontFamily x:Key="CcIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Buttons: one rounded template, variants differ only in colours. -->
        <Style x:Key="CcButtonBase" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CcGhostButton" TargetType="Button" BasedOn="{StaticResource CcButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CcHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource CcPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CcSecondaryButton" TargetType="Button" BasedOn="{StaticResource CcGhostButton}">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderBrushKey}}" />
        </Style>

        <Style x:Key="CcPrimaryButton" TargetType="Button" BasedOn="{StaticResource CcButtonBase}">
            <Setter Property="Background" Value="{StaticResource CcAccent}" />
            <Setter Property="BorderBrush" Value="{StaticResource CcAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CcAccentHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource CcAccentPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CcDangerButton" TargetType="Button" BasedOn="{StaticResource CcButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource CcError}" />
            <Setter Property="BorderBrush" Value="{StaticResource CcErrorBorder}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CcErrorSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CcIconButton" TargetType="Button" BasedOn="{StaticResource CcGhostButton}">
            <Setter Property="FontFamily" Value="{StaticResource CcIconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
        </Style>

        <Style x:Key="CcSuggestionButton" TargetType="Button" BasedOn="{StaticResource CcButtonBase}">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBackgroundBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderBrushKey}}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CcAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CcSendButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{StaticResource CcAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource CcIconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CcAccentHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource CcAccentPressed}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CcStopButton" TargetType="Button" BasedOn="{StaticResource CcSendButton}">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CcAccent}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small pill toggle used for the editor-context switch. -->
        <Style x:Key="CcChipToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource CcAccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsChecked" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource CcHover}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact drop-down that looks like a chip; the list opens upwards from the composer. -->
        <Style x:Key="CcChipComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxTextBrushKey}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="9,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CcHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource CcAccent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CcChipCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CcChipComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="7,3">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CcHover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CcPressed}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource CcIconFont}" FontSize="8" Margin="6,1,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Top" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" VerticalOffset="-4">
                                <Border MinWidth="170" Padding="4" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBackgroundBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderBrushKey}}">
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless text boxes: the composer input and read-only selectable text in the transcript. -->
        <Style x:Key="CcComposerTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxTextBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      Padding="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CcPlainTextBox" TargetType="TextBox" BasedOn="{StaticResource CcComposerTextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: new chat on the left, plan usage on the right (independent of the conversation). -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Padding="6,4" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Button x:Name="NewSessionButton" DockPanel.Dock="Left" Style="{StaticResource CcGhostButton}" Padding="8,4"
                        ToolTip="Yeni sohbet başlat (/clear)" Click="OnNewSessionClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource CcIconFont}" FontSize="11" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Yeni sohbet" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="HistoryButton" DockPanel.Dock="Left" Style="{StaticResource CcGhostButton}" Padding="8,4"
                        ToolTip="Geçmiş sohbetler" Click="OnHistoryClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource CcIconFont}" FontSize="11" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Geçmiş" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="AccountBadge" DockPanel.Dock="Right" Style="{StaticResource CcGhostButton}" Padding="7,3" Margin="2,0,0,0"
                        Click="OnAccountBadgeClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AccountBadgeGlyph" Text="&#xE77B;" FontFamily="{StaticResource CcIconFont}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="AccountBadgeText" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </Button>
                <Border x:Name="UsageSummaryHost" DockPanel.Dock="Right" VerticalAlignment="Center" />
                <Button x:Name="PrivacyBadge" DockPanel.Dock="Right" Style="{StaticResource CcGhostButton}" Padding="7,3" Margin="0,0,4,0"
                        Click="OnPrivacyBadgeClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PrivacyBadgeGlyph" FontFamily="{StaticResource CcIconFont}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="PrivacyBadgeText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <Border x:Name="UsageDetailsHost" Grid.Row="1" />

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="TranscriptScroll"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnTranscriptMouseWheel" ScrollChanged="OnTranscriptScrollChanged">
                <StackPanel x:Name="Transcript" Margin="16,6,16,14" />
            </ScrollViewer>
            <Border x:Name="HistoryHost" Visibility="Collapsed" />
        </Grid>

        <!-- Composer -->
        <StackPanel Grid.Row="3" Margin="10,2,10,8">
            <Border x:Name="ComposerBorder" CornerRadius="8" BorderThickness="1" Padding="2">
                <StackPanel>
                    <WrapPanel x:Name="ContextChips" Margin="8,7,8,0" Visibility="Collapsed" />
                    <Grid Margin="8,8,8,2">
                        <TextBox x:Name="InputBox" Style="{StaticResource CcComposerTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="38" MaxHeight="220" VerticalScrollBarVisibility="Auto" AllowDrop="True"
                                 PreviewKeyDown="OnInputPreviewKeyDown" TextChanged="OnInputTextChanged"
                                 PreviewDragOver="OnInputDragOver" PreviewDrop="OnInputDrop" />
                        <TextBlock x:Name="InputPlaceholder" Margin="2,0,0,0" IsHitTestVisible="False" TextWrapping="Wrap"
                                   Text="Claude'a bir şey sorun…  (@ dosya, / komut, Ctrl+V görsel)" />
                    </Grid>
                    <DockPanel Margin="4,0,5,5">
                        <Grid DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="6,0,0,0">
                            <Button x:Name="SendButton" Style="{StaticResource CcSendButton}" Content="&#xE724;"
                                    ToolTip="Gönder (Enter)" Click="OnSendClick" />
                            <Button x:Name="StopButton" Style="{StaticResource CcStopButton}" Content="&#xE71A;"
                                    ToolTip="Durdur (Esc)" Click="OnStopClick" Visibility="Collapsed" />
                        </Grid>
                        <WrapPanel VerticalAlignment="Center">
                            <ToggleButton x:Name="ContextToggle" Style="{StaticResource CcChipToggle}" Margin="0,2,2,2" />
                            <ComboBox x:Name="ModeCombo" Style="{StaticResource CcChipCombo}" Margin="0,2,2,2"
                                      ToolTip="İzin modu" SelectionChanged="OnModeChanged" />
                            <ComboBox x:Name="ModelCombo" Style="{StaticResource CcChipCombo}" Margin="0,2,2,2"
                                      ToolTip="Model" SelectionChanged="OnModelChanged" />
                            <Button x:Name="ContextUsageButton" Style="{StaticResource CcGhostButton}" Padding="7,3" Margin="0,2,2,2"
                                    Visibility="Collapsed" Click="OnContextUsageClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ContextUsageGlyph" Text="◔" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ContextUsageText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Margin="6,5,6,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
